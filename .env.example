# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=project_management
POSTGRES_PORT=5432

# Connection string para Prisma (usar en apps/api y packages/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_management?schema=app

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_PASSWORD=redis
REDIS_PORT=6379
REDIS_COMMANDER_PORT=8081

# Connection string para Redis (usar en apps/api)
REDIS_URL=redis://:redis@localhost:6379

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development

# API Configuration (apps/api)
API_PORT=4000
API_HOST=localhost

# Web Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000